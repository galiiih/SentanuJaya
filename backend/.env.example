# Django-like template for credentials in .env.example

# Admin credentials (for local development only)
ADMIN_USER=admin@sentanu.local
ADMIN_PASSWORD=SentanuDev2026!

# Owner credentials (for local development only)
OWNER_USER=owner@sentanu.local
OWNER_PASSWORD=SentanuDev2026!

# Staff credentials (for local development only)
STAFF_USER=staff@sentanu.local
STAFF_PASSWORD=SentanuDev2026!

# Application settings
APP_NAME=Sentanu Jaya Web App
APP_VERSION=1.0.0
APP_ENV=local
LOG_LEVEL=info

# Token: This secret key is used for signing JWT and other encrypted tokens.
APP_KEY=Generate a secure random key at https://laravel.com/docs/master/installation#encryption

# Database connection (SQLite for local dev)
DATABASE_URL=sqlite:///storage/database.sqlite
DB_CONNECTION=sqlite
DB_DATABASE=D:/ProyekAsistenAI/sunday-brain/01_Proyek/Sentanu Jaya Web App/backend/database/database.sqlite

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_CHANNEL=stack

# CSRF token key
CSRF_COOKIE_NAME="XSRF-TOKEN"

# Session settings
SESSION_NAME=session
SESSION_SECURE=true
SESSION_HTTPONLY=true

# Compression level (0-9) used in PHP
ZLIB_OUTPUT_COMPRESSION=0
