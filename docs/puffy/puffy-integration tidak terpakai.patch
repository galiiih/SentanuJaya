+.puffy-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(5.4rem, 1fr)); gap: .4rem; margin-bottom: var(--space-sm); }
+.puffy-metric { padding: .4rem .55rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-raised); }
