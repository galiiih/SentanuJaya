+.puffy-svg[data-talking="true"] .puffy-mouth-open { animation: puffy-yap .2s ease-in-out infinite alternate; }
+@keyframes puffy-yap { from { transform: scaleY(.3); } to { transform: scaleY(1.15); } }
+
+/* Ekor balon chat saat Puffy mengecil */
+.puffy-tail { position: absolute; left: 34px; top: 34px; width: 20px; height: 20px; background: var(--puffy-body); clip-path: polygon(0 0, 100% 100%, 0 100%); opacity: 0; transition: opacity .3s; }
+.puffy-tail[data-visible="true"] { opacity: 1; }
+
+.puffy-fx { position: absolute; left: 50%; top: 0; font-size: 1.3rem; pointer-events: none; animation: puffy-fx 1.6s ease-out forwards; }
+@keyframes puffy-fx { from { transform: translate(-50%, 0) scale(.6); opacity: 0; } 20% { opacity: 1; } to { transform: translate(-50%, -34px) scale(1.1); opacity: 0; } }
+
+/* Bubble ucapan: "Ask me" saat idle, komentar singkat saat aktif */
+.puffy-say { position: absolute; width: max-content; max-width: 14rem; padding: .45rem .7rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-md); font-size: .76rem; font-weight: 700; line-height: 1.35; text-align: left; opacity: 0; transition: opacity .2s; pointer-events: none; }
+.puffy-say[data-visible="true"] { opacity: 1; }
+.puffy-say--home { bottom: 100%; left: 0; margin-bottom: .2rem; }
+.puffy-say--left { top: 50%; right: 100%; margin-right: .45rem; transform: translateY(-50%); }
+.puffy-say--closed { top: 50%; right: 100%; margin-right: .5rem; transform: translateY(-50%); border-color: transparent; background: var(--color-primary); color: #fff; pointer-events: auto; }
+
+/* Elemen yang sedang ditunjuk Puffy */
+.puffy-hl { outline: 3px solid var(--puffy-arm); outline-offset: 3px; box-shadow: 0 0 0 9px rgb(255 134 176 / 18%); transition: outline-color .3s, box-shadow .3s; }
+
+@media (prefers-reduced-motion: reduce) {
