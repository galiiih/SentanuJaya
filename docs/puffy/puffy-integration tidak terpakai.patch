+.puffy-svg[data-mood="happy"] .puffy-eyes-happy, .puffy-svg[data-mood="love"] .puffy-eyes-happy, .puffy-svg[data-mood="excited"] .puffy-eyes-happy { opacity: 1; }
+.puffy-svg[data-mood="happy"] .puffy-cheek, .puffy-svg[data-mood="love"] .puffy-cheek, .puffy-svg[data-mood="excited"] .puffy-cheek { opacity: 1; }
+.puffy-mouth { fill: none; stroke: var(--puffy-ink); stroke-width: 2.4; stroke-linecap: round; transition: opacity .15s; }
+.puffy-mouth-open { fill: var(--puffy-mouth); opacity: 0; transform-box: fill-box; transform-origin: center; transition: opacity .15s; }
+.puffy-svg[data-talking="true"] .puffy-mouth, .puffy-svg[data-mood="excited"] .puffy-mouth { opacity: 0; }
