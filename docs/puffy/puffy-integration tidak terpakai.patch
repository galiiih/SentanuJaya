@@ -0,0 +1,161 @@
+/*
+ * Gaya Puffy. Semua warna, radius, bayangan, dan tema (terang/gelap lewat [data-theme="dark"])
+ * memakai token dari App.css, jadi mengikuti tampilan Sentanu Jaya tanpa JavaScript tambahan.
+ * Semua selector diawali "puffy-" agar tidak menabrak class yang sudah ada.
+ */
+:root {
+  --puffy-body: #ffb6d0;
+  --puffy-arm: #ff86b0;
+  --puffy-foot: #e8527f;
+  --puffy-ink: #2b1633;
+  --puffy-cheek: #ff6f9f;
+  --puffy-mouth: #7a1f3d;
+  --puffy-ease: cubic-bezier(.5, 0, .2, 1);
+}
+
+/* ---------- Ruang di layout: konten menyempit saat panel terbuka, melebar saat Puffy mengecil ---------- */
+html.puffy-ready .app-content { transition: padding-right .6s var(--puffy-ease); }
+@media (min-width: 821px) {
+  html.puffy-open .app-content { padding-right: calc(22.5rem + 1.25rem + var(--space-lg)); }
+}
+
+/* ---------- Panel chat ---------- */
+.puffy-panel {
+  position: fixed; z-index: 80; right: 1.25rem; bottom: 5.5rem;
+  display: flex; flex-direction: column;
+  width: 22.5rem; max-width: calc(100vw - 1.5rem); height: min(35rem, calc(100dvh - 10.5rem));
+  border: 1px solid var(--color-border); border-radius: var(--radius-lg);
+  background: var(--color-surface); color: var(--color-text); box-shadow: var(--shadow-md);
+  transform-origin: calc(100% - 30px) calc(100% + 38px); /* menyusut ke arah balon di pojok kanan bawah */
+  transition: transform .6s var(--puffy-ease), opacity .45s ease, visibility 0s;
+}
+.puffy-panel[data-open="false"] {
