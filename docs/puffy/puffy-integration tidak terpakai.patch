+.puffy-msg--me { align-self: flex-end; border-bottom-right-radius: .2rem; background: var(--color-primary); color: #fff; }
+.puffy-msg--ai { border-bottom-left-radius: .2rem; background: var(--color-surface-raised); color: var(--color-text); }
+.puffy-ai { max-width: 100%; }
+.puffy-status { display: flex; align-items: center; gap: .25rem; margin-bottom: .3rem; color: var(--color-text-secondary); font-size: .72rem; }
