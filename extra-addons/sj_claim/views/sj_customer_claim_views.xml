<odoo>
    <record id="view_sj_customer_claim_tree" model="ir.ui.view">
        <field name="name">sj.customer.claim.tree</field>
        <field name="model">sj.customer.claim</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-warning="state=='review'" decoration-success="state in ('done','closed')" decoration-danger="state=='invalid'" decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="delivery_id"/>
                <field name="partner_id"/>
                <field name="date_claim"/>
                <field name="reason_id"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-warning="state=='review'" decoration-success="state in ('valid','done','closed')" decoration-danger="state=='invalid'"/>
            </tree>
        </field>
    </record>

    <record id="view_sj_customer_claim_form" model="ir.ui.view">
        <field name="name">sj.customer.claim.form</field>
        <field name="model">sj.customer.claim</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" type="object" string="Review" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_valid" type="object" string="Valid" class="btn-primary" invisible="state != 'review'" groups="sj_security.group_sj_qc"/>
                    <button name="action_mark_invalid" type="object" string="Invalid" invisible="state != 'review'" groups="sj_security.group_sj_qc"/>
                    <button name="action_customer_return" type="object" string="Customer Return" invisible="state != 'valid'"/>
                    <button name="action_create_rework" type="object" string="Create Rework" class="btn-primary" invisible="state not in ('valid','returned')" groups="sj_security.group_sj_manager"/>
                    <button name="action_done" type="object" string="Done" invisible="state not in ('rework','returned')" groups="sj_security.group_sj_manager"/>
                    <button name="action_close" type="object" string="Close" invisible="state not in ('done','invalid')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,valid,rework,done,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reworks" type="object" class="oe_stat_button" icon="fa-refresh" invisible="not rework_ids">
                            <field name="rework_count" string="Reworks" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="delivery_id"/>
                            <field name="partner_id"/>
                            <field name="date_claim"/>
                        </group>
                        <group>
                            <field name="reason_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Claim Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="delivery_line_id" domain="[('delivery_id', '=', parent.delivery_id)]"/>
                                    <field name="batch_id"/>
                                    <field name="product_id"/>
                                    <field name="color_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="defect_id"/>
                                    <field name="note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Rework">
                            <field name="rework_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="delivery_id"/>
                                    <field name="redelivery_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Review Note">
                            <field name="review_note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sj_customer_claim_search" model="ir.ui.view">
        <field name="name">sj.customer.claim.search</field>
        <field name="model">sj.customer.claim</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_id"/>
                <field name="reason_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="review" string="Under Review" domain="[('state','=','review')]"/>
                <filter name="valid" string="Valid" domain="[('state','=','valid')]"/>
                <filter name="rework" string="Rework" domain="[('state','=','rework')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="open" string="Open Claims" domain="[('state','not in',('done','closed','invalid'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_reason" string="Reason" context="{'group_by':'reason_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by':'date_claim:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sj_customer_claim" model="ir.actions.act_window">
        <field name="name">Customer Claims</field>
        <field name="res_model">sj.customer.claim</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sj_customer_claim_search"/>
    </record>
</odoo>
