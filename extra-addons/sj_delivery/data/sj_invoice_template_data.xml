<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="invoice_template_ppn_pph" model="sj.invoice.template">
            <field name="name">Invoice PPN + PPh</field>
            <field name="code">PPN_PPH</field>
            <field name="sequence">10</field>
            <field name="qweb_template">sj_delivery.report_invoice_body_ppn_pph</field>
            <field name="description">Format invoice lengkap dengan split Biaya Bahan/Jasa, PPN 11%, dan potongan PPh 23 dari jasa. Digunakan untuk customer yang menggunakan PPN dan PPh.</field>
        </record>

        <record id="invoice_template_ppn_only" model="sj.invoice.template">
            <field name="name">Invoice PPN Only</field>
            <field name="code">PPN_ONLY</field>
            <field name="sequence">20</field>
            <field name="qweb_template">sj_delivery.report_invoice_body_ppn_only</field>
            <field name="description">Format invoice dengan split Biaya Bahan/Jasa dan PPN 11%. Tanpa potongan PPh.</field>
        </record>

        <record id="invoice_template_pph_only" model="sj.invoice.template">
            <field name="name">Invoice PPh Only</field>
            <field name="code">PPH_ONLY</field>
            <field name="sequence">30</field>
            <field name="qweb_template">sj_delivery.report_invoice_body_pph_only</field>
            <field name="description">Format invoice dengan split Biaya Bahan/Jasa dan potongan PPh 23 dari jasa. Tanpa PPN.</field>
        </record>

        <record id="invoice_template_non_tax" model="sj.invoice.template">
            <field name="name">Invoice Non Tax</field>
            <field name="code">NON_TAX</field>
            <field name="sequence">40</field>
            <field name="qweb_template">sj_delivery.report_invoice_body_non_tax</field>
            <field name="description">Format invoice sederhana (No, Qty, Nama Barang, Warna, Harga, Jumlah). Tanpa PPN dan PPh.</field>
        </record>
    </data>
</odoo>
