<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_sj_delivery_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 class="text-center">
                            <t t-if="doc.delivery_type == 'normal'">SURAT JALAN KELUAR</t>
                            <t t-else="">SURAT JALAN PENGIRIMAN ULANG</t>
                        </h2>
                        <h3 class="text-center"><t t-esc="doc.name"/></h3>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <table class="table table-sm table-borderless">
                                    <tr><td><strong>Customer</strong></td><td>: <t t-esc="doc.partner_id.name"/></td></tr>
                                    <tr><td><strong>Tanggal Kirim</strong></td><td>: <t t-esc="doc.date_delivery" t-options="{'widget': 'date'}"/></td></tr>
                                    <tr><td><strong>Tipe</strong></td><td>: <t t-esc="dict(doc._fields['delivery_type'].selection).get(doc.delivery_type)"/></td></tr>
                                    <tr t-if="doc.origin"><td><strong>Referensi</strong></td><td>: <t t-esc="doc.origin"/></td></tr>
                                    <tr><td><strong>Status</strong></td><td>: <t t-esc="dict(doc._fields['state'].selection).get(doc.state)"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th class="text-center">No</th>
                                    <th>Item</th>
                                    <th>Warna</th>
                                    <th>Batch</th>
                                    <th class="text-center">Qty</th>
                                    <th>UoM</th>
                                    <th class="text-end">Harga</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td class="text-center"><t t-esc="line_index + 1"/></td>
                                        <td><t t-esc="line.product_id.name"/></td>
                                        <td><t t-esc="line.color_id.name or '-'"/></td>
                                        <td><t t-esc="line.batch_id.name"/></td>
                                        <td class="text-center"><t t-esc="line.qty"/></td>
                                        <td><t t-esc="line.uom_id.name or 'Unit'"/></td>
                                        <td class="text-end"><t t-esc="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                        <td class="text-end"><t t-esc="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="7" class="text-end"><strong>Total</strong></td>
                                    <td class="text-end"><strong><t t-esc="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></strong></td>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-4" t-if="doc.note">
                            <div class="col-12">
                                <strong>Catatan:</strong>
                                <p><t t-esc="doc.note"/></p>
                            </div>
                        </div>

                        <div class="row mt-5">
                            <div class="col-4 text-center">
                                <p>Pengirim,</p>
                                <br/><br/><br/>
                                <p>(_________________)</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Diketahui,</p>
                                <br/><br/><br/>
                                <p>(_________________)</p>
                            </div>
                            <div class="col-4 text-center">
                                <p>Penerima,</p>
                                <br/><br/><br/>
                                <p>(_________________)</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_sj_delivery" model="ir.actions.report">
        <field name="name">Surat Jalan Keluar</field>
        <field name="model">sj.delivery</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sj_delivery.report_sj_delivery_document</field>
        <field name="report_file">sj_delivery.report_sj_delivery_document</field>
        <field name="binding_model_id" ref="model_sj_delivery"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
