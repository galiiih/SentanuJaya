    <template id="report_invoice_body_non_tax">
        <table class="table table-sm table-bordered" style="font-size: 8.5pt; border-color: #000; margin-bottom: 5px;">
            <thead>
                <tr class="text-center" style="background-color: #f2f2f2;">
                    <th style="width:5%;">No</th>
                    <th style="width:6%;">Qty</th>
                    <th style="width:6%;">Sat</th>
                    <th>Nama Barang</th>
                    <th style="width:15%;">Warna</th>
                    <th style="width:14%;">Harga</th>
                    <th style="width:8%;">Ket</th>
                    <th style="width:15%;">Jumlah</th>
                </tr>
            </thead>
            <tbody>
                <t t-foreach="doc.line_ids" t-as="line">
                    <tr>
                        <td class="text-center"><t t-esc="line_index + 1"/></td>
                        <td class="text-center"><t t-esc="int(line.qty)"/></td>
                        <td class="text-center"><t t-esc="line.uom_id.name or 'Pcs'"/></td>
                        <td><t t-esc="line.product_id.name"/></td>
                        <td><t t-esc="line.color_id.name or '-'"/></td>
                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.price_unit)"/></td>
                        <td class="text-center"><t t-esc="line.note or ''"/></td>
                        <td class="text-end"><t t-esc="'{:,.0f}'.format(line.price_subtotal)"/></td>
                    </tr>
                </t>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="7" class="text-end"><strong>SUB TOTAL</strong></td>
                    <td class="text-end"><strong><t t-esc="'{:,.0f}'.format(doc.amount_untaxed)"/></strong></td>
                </tr>
            </tfoot>
        </table>
        <div class="mt-2" style="font-size: 8pt; color: #555;">
            <strong>CATATAN:</strong><br/>
            <span>Barang yang telah diterima dalam keadaan baik dan cukup.</span><br/>
            <span>Jika dikemudian hari ada barang NG bukan lagi tanggung jawab kami.</span>
        </div>
    </template>

    <record id="action_report_sj_invoice" model="ir.actions.report">
        <field name="name">Invoice Sentanu Jaya</field>
        <field name="model">sj.delivery</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sj_delivery.report_sj_invoice_document</field>
        <field name="report_file">sj_delivery.report_sj_invoice_document</field>
        <field name="binding_model_id" ref="model_sj_delivery"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sj_kwitansi_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page" style="font-size: 9.5pt; font-family: 'Arial', sans-serif; color: #000;">
                    <div class="row">
                        <div class="col-7">
                            <img t-att-src="'data:image/png;base64,%s' % doc._sj_logo_b64()"
                                 style="max-height: 55px; max-width: 100%;" alt="PT. Sentanu Jaya"/>
                            <div style="font-size: 8pt; margin-top: 3px;">
                                <span>Jl. Hasyim Ashari GG Turus RT.02 RW.02 No.99</span><br/>
                                <span>Nerogtog, Pinang, Kota Tangerang, Banten</span>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-2 mb-3">
                        <h4 style="margin-bottom: 0; font-weight: bold; letter-spacing: 2px;">KWITANSI</h4>
                        <span>NO. <t t-esc="doc.name"/></span>
                    </div>
                    <table class="table table-sm table-bordered" style="margin-bottom: 1.5rem; border-color: #000;">
                        <tr>
                            <td style="width: 25%; padding: 6px;"><strong>Sudah terima dari</strong></td>
                            <td style="padding: 6px;">: <t t-esc="doc.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Terbilang</strong></td>
                            <td style="padding: 6px; background-color: #f9f9f9;">: # <strong><t t-esc="doc._sj_amount_to_words()"/></strong> #</td>
                        </tr>
                        <tr>
                            <td style="padding: 6px;"><strong>Untuk pembayaran</strong></td>
                            <td style="padding: 6px;">: <t t-foreach="doc.line_ids" t-as="line"><t t-esc="line.product_id.name"/><t t-if="not line_last">, </t></t><t t-if="doc.origin"><br/>PO: <t t-esc="doc.origin"/></t></td>
                        </tr>
                    </table>
                    <div class="row mb-3">
                        <div class="col-4">
                            <table class="table table-sm table-bordered" style="border-color: #000;">
                                <tr style="background-color: #f2f2f2;">
                                    <td style="width: 25%; font-weight: bold;">Rp.</td>
                                    <td class="text-end" style="font-size: 11pt;"><strong><t t-esc="'{:,.0f}'.format(doc.amount_grand_total)"/></strong></td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-4"/>
                        <div class="col-4 text-center" style="padding-top: 5px;">
                            <span>Tangerang, <t t-esc="doc.date_delivery" t-options="{'widget': 'date', 'format': 'd MMMM y'}"/></span>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-6" style="font-size: 8.5pt; color: #333;">
                            <span>Pembayaran dengan Giro/Cek</span><br/>
                            <span>A.N: PT. SENTANU JAYA</span><br/>
                            <span>Bank BCA No. Rekening: 6585467911</span>
                        </div>
                        <div class="col-6 text-center">
                            <br/>
                            <strong>PT. SENTANU JAYA</strong><br/><br/><br/>
                            <u>Tri Sutanti</u>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_sj_kwitansi" model="ir.actions.report">
        <field name="name">Kwitansi</field>
        <field name="model">sj.delivery</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sj_delivery.report_sj_kwitansi_document</field>
        <field name="report_file">sj_delivery.report_sj_kwitansi_document</field>
        <field name="binding_model_id" ref="model_sj_delivery"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
