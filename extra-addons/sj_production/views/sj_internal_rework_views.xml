<odoo>
    <record id="view_sj_internal_rework_tree" model="ir.ui.view">
        <field name="name">sj.internal.rework.tree</field>
        <field name="model">sj.internal.rework</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-warning="state=='in_progress'" decoration-success="state=='done'" decoration-muted="state=='cancel'">
                <field name="name"/>
                <field name="batch_id"/>
                <field name="source_qc_id"/>
                <field name="target_wo_type"/>
                <field name="reason_id"/>
                <field name="work_order_id"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-warning="state=='in_progress'" decoration-success="state=='done'"/>
            </tree>
        </field>
    </record>

    <record id="view_sj_internal_rework_form" model="ir.ui.view">
        <field name="name">sj.internal.rework.form</field>
        <field name="model">sj.internal.rework</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" type="object" string="Done" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('done','cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="batch_id"/>
                            <field name="source_qc_id"/>
                            <field name="target_wo_type"/>
                        </group>
                        <group>
                            <field name="reason_id"/>
                            <field name="work_order_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Rework notes..."/>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_sj_internal_rework" model="ir.actions.act_window">
        <field name="name">Internal Rework</field>
        <field name="res_model">sj.internal.rework</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
