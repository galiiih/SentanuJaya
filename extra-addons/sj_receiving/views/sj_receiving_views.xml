<odoo>
    <record id="view_sj_receiving_tree" model="ir.ui.view">
        <field name="name">sj.receiving.tree</field>
        <field name="model">sj.receiving</field>
        <field name="arch" type="xml">
            <tree decoration-info="state=='draft'" decoration-success="state=='qc_pass'" decoration-danger="state=='qc_reject'" decoration-muted="state=='cancel'">
                <field name="name"/>
                <field name="customer_sj_number"/>
                <field name="partner_id"/>
                <field name="date_received"/>
                <field name="line_count"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-success="state in ('received','qc_pass')" decoration-danger="state=='qc_reject'" decoration-warning="state=='returned'"/>
            </tree>
        </field>
    </record>

    <record id="view_sj_receiving_form" model="ir.ui.view">
        <field name="name">sj.receiving.form</field>
        <field name="model">sj.receiving</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_qc_pass" type="object" string="QC Pass" class="btn-primary" invisible="state != 'received'" groups="sj_security.group_sj_qc"/>
                    <button name="action_qc_reject" type="object" string="QC Reject" invisible="state != 'received'" groups="sj_security.group_sj_qc"/>
                    <button name="action_return" type="object" string="Return" invisible="state not in ('qc_reject',)"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancel','returned')"/>
                    <button name="action_reset_to_draft" type="object" string="Reset Draft" invisible="state not in ('cancel',)" groups="sj_security.group_sj_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,received,qc_pass"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="customer_sj_number"/>
                        </group>
                        <group>
                            <field name="date_received"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="item_description"/>
                                    <field name="color_id"/>
                                    <field name="qty"/>
                                    <field name="uom_id"/>
                                    <field name="qc_state" widget="badge" decoration-success="qc_state=='pass'" decoration-danger="qc_state=='reject'" decoration-info="qc_state=='pending'"/>
                                    <field name="reject_reason_id"/>
                                    <field name="qc_note"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_sj_receiving_search" model="ir.ui.view">
        <field name="name">sj.receiving.search</field>
        <field name="model">sj.receiving</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="customer_sj_number"/>
                <field name="partner_id"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="received" string="Received" domain="[('state','=','received')]"/>
                <filter name="qc_pass" string="QC Passed" domain="[('state','=','qc_pass')]"/>
                <filter name="qc_reject" string="QC Rejected" domain="[('state','=','qc_reject')]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('date_received','=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_month" string="This Month" domain="[('date_received','&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_received','&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_date" string="Date Received" context="{'group_by':'date_received:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sj_receiving" model="ir.actions.act_window">
        <field name="name">Surat Jalan Masuk</field>
        <field name="res_model">sj.receiving</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sj_receiving_search"/>
        <field name="context">{'search_default_filter_today': 0}</field>
    </record>
</odoo>
