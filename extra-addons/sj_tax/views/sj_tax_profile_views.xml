<odoo>
    <record id="view_sj_tax_profile_tree" model="ir.ui.view">
        <field name="name">sj.tax.profile.tree</field>
        <field name="model">sj.tax.profile</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="use_ppn"/>
                <field name="use_pph"/>
                <field name="pph_rate"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_sj_tax_profile_form" model="ir.ui.view">
        <field name="name">sj.tax.profile.form</field>
        <field name="model">sj.tax.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="use_ppn"/>
                            <field name="ppn_tax_id"/>
                            <field name="use_pph"/>
                            <field name="pph_tax_id"/>
                            <field name="pph_rate"/>
                        </group>
                    </group>
                    <group>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sj_tax_profile" model="ir.actions.act_window">
        <field name="name">Tax Profiles</field>
        <field name="res_model">sj.tax.profile</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
