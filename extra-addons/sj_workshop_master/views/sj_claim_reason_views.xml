<odoo>
    <record id="view_sj_claim_reason_tree" model="ir.ui.view">
        <field name="name">sj.claim.reason.tree</field>
        <field name="model">sj.claim.reason</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_sj_claim_reason_form" model="ir.ui.view">
        <field name="name">sj.claim.reason.form</field>
        <field name="model">sj.claim.reason</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sj_claim_reason" model="ir.actions.act_window">
        <field name="name">Claim Reasons</field>
        <field name="res_model">sj.claim.reason</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
