<odoo>
    <record id="view_sj_defect_tree" model="ir.ui.view">
        <field name="name">sj.defect.tree</field>
        <field name="model">sj.defect</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="defect_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_sj_defect_form" model="ir.ui.view">
        <field name="name">sj.defect.form</field>
        <field name="model">sj.defect</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="defect_type"/>
                        <field name="active"/>
                        <field name="note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_sj_defect" model="ir.actions.act_window">
        <field name="name">Defects</field>
        <field name="res_model">sj.defect</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
